{
  "permissions": {
    "allow": [
      "Bash(cargo:*)",
      "Bash(rustup:*)",
      "Bash(pnpm:*)",
      "Bash(node:*)",
      "Bash(npm pack:*)",
      "Bash(npm view:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git tag -l:*)",
      "Bash(./target/debug/splice:*)",
      "Bash(./target/release/splice:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(npm publish:*)"
    ]
  },
  "enabledPlugins": {
    "superpowers@superpowers-marketplace": true,
    "caveman@caveman": true
  },
  "extraKnownMarketplaces": {
    "superpowers-marketplace": {
      "source": {
        "source": "github",
        "repo": "obra/superpowers-marketplace"
      }
    },
    "caveman": {
      "source": {
        "source": "github",
        "repo": "akramsystems/caveman"
      }
    }
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/sync-decisions.sh\"",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
